modules = ["nodejs-20", "web", "python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[userenv]

[userenv.shared]
NEXTAUTH_URL = "https://befluent-edu.online"
ZEGO_APP_ID = "1050328575"
SMTP2GO_FROM_EMAIL = "noreply@befluent-edu.online"
SMTP2GO_FROM_NAME = "Be Fluent Academy"
WHATSAPP_PROVIDER = "baileys"
QMEET_API_BASE_URL = "https://qiroxstudio.online"

[userenv.development]
PHASE5_DATABASE_ENABLED = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Be Fluent Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev-resource-guard"

[[workflows.workflow]]
name = "Be Fluent Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "dev-resource-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test tests/dev-resource-guard.test.cjs && node --check scripts/typecheck.cjs && node --check start-server.js"

[workflows.workflow.metadata]
isValidation = true

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "install"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000
