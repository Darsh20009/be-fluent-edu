# B Fluent EDU — server-side configuration only
# Never commit real values. Configure production values in Render Secret Files/
# Environment Variables and local values in an untracked .env.local.

NODE_ENV=development
PORT=5000

# MongoDB is the only supported application database.
MONGODB_URI=

# NextAuth / authentication
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
AUTH_SECRET=

# QMeet server-side provider
QMEET_API_BASE_URL=
QMEET_API_KEY=

# WhatsApp provider/worker (Baileys is not enabled by Phase 1)
WHATSAPP_SESSION_STORE=
WHATSAPP_PHONE_NUMBER=

# Email provider
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=befluent@qirox.online
SMTP2GO_FROM_NAME=Be Fluent

# AI providers
OPENAI_API_KEY=
KIMI_API_KEY=
