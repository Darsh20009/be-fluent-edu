# B Fluent EDU — server-side configuration only
# Never commit real values. Configure production values in Render Secret Files/
# Environment Variables and local values in an untracked .env.local.

NODE_ENV=development
PORT=5000

# NextAuth / authentication
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
AUTH_SECRET=
SESSION_SECRET=
AUTH_OTP_TEST_MODE=false

# QMeet server-side provider
QMEET_API_BASE_URL=
QMEET_API_KEY=

# Internal WhatsApp CRM and authentication OTP transport
WHATSAPP_PROVIDER=baileys

# Qirox project email provider
QIROX_EMAIL_API_KEY=
# Required as a separate provider key in production; the development key is never reused there.
QIROX_EMAIL_API_KEY_PRODUCTION=

# AI providers
OPENAI_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=

# Public/runtime URLs
NEXT_PUBLIC_APP_URL=http://localhost:5000
