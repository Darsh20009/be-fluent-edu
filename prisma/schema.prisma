generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Assignment {
  id             String       @id @default(uuid()) @map("_id")
  sessionId      String?      
  teacherId      String?      // ID of the teacher who created this (optional)
  studentId      String?      // ID of the student this is assigned to (optional)
  title          String
  description    String?
  type           String       @default("TEXT")
  attachmentUrls String?
  multipleChoice String?
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  Session        Session?     @relation(fields: [sessionId], references: [id])
  Submission     Submission[]
}

model AuditLog {
  id        String   @id @default(uuid()) @map("_id")
  action    String
  userId    String?  
  details   String?
  entityType String?
  entityId   String?
  metadataJson String?
  success    Boolean?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Chat {
  id                         String   @id @default(uuid()) @map("_id")
  fromUserId                 String   
  toUserId                   String   
  content                    String
  attachments                String?
  isSaved                    Boolean  @default(false)
  createdAt                  DateTime @default(now())
  User_Chat_fromUserIdToUser User     @relation("Chat_fromUserIdToUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  User_Chat_toUserIdToUser   User     @relation("Chat_toUserIdToUser", fields: [toUserId], references: [id], onDelete: Cascade)
}

model Package {
  id            String         @id @default(uuid()) @map("_id")
  title         String
  titleAr       String
  description   String?
  descriptionAr String?
  price         Float
  discountPrice Float?         // السعر بعد الخصم المباشر
  lessonsCount  Int
  durationDays  Int
  subscriptionType SubscriptionType?
  levelId       String?
  stageId       String?
  capacity      Int?
  featuresJson  String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  CartItem      CartItem[]
  Subscription  Subscription[]
  Enrollment    Enrollment[]
  level         Level?         @relation("PackageLevel", fields: [levelId], references: [id])
  stage         LevelStage?    @relation("PackageStage", fields: [stageId], references: [id])

  @@index([subscriptionType, isActive])
  @@index([levelId, stageId])
}

model Session {
  id               String           @id @default(uuid()) @map("_id")
  teacherId        String           
  title            String
  startTime        DateTime
  endTime          DateTime
  status           String           @default("SCHEDULED")
  roomId           String?          @unique
  recordingUrl     String?
  sessionPassword  String?
  externalLink     String?
  externalLinkType String?          // ZOOM, GOOGLE_MEET, TEAMS, OTHER
  whatsappNumber   String?          // Direct WhatsApp contact for this session
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  Assignment       Assignment[]
  TeacherProfile   TeacherProfile   @relation(fields: [teacherId], references: [id])
  SessionStudent   SessionStudent[]
  levelId          String?
  level            Level?            @relation("SessionLevel", fields: [levelId], references: [id])
  stageId          String?
  stage            LevelStage?       @relation("SessionStage", fields: [stageId], references: [id])
  groupId          String?
  group            LearningGroup?    @relation("GroupSessions", fields: [groupId], references: [id])
  groupScheduleId  String?
  groupSchedule    GroupSchedule?    @relation("ScheduledSessions", fields: [groupScheduleId], references: [id])
  participants     SessionParticipant[]
  attendances      Attendance[]
  qmeetMeeting     QMeetMeeting?
  feedback         SessionFeedback[]
  homework         Homework[]        @relation("SessionHomework")

  @@index([status, startTime])
  @@index([teacherId, startTime])
  @@index([groupId, startTime])
}

model SessionStudent {
  id        String   @id @default(uuid()) @map("_id")
  sessionId String   
  studentId String   
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())
  Session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model StudentProfile {
  id                      String   @id @default(uuid()) @map("_id")
  userId                  String   @unique 
  age                     Int?
  levelInitial            String?
  levelCurrent            String?
  targetLevel             String?
  goal                    String?
  preferredTime           String?
  placementTestScore      Int?
  placementTestPercentage Int?
  packageId               String?
  receiptUrl              String?
  isVerified              Boolean  @default(false)
  officialLevelId         String?
  officialStageId         String?
  recommendedLevelId      String?
  recommendedStageId      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
  User                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialLevel           Level?   @relation("StudentOfficialLevel", fields: [officialLevelId], references: [id])
  officialStage           LevelStage? @relation("StudentOfficialStage", fields: [officialStageId], references: [id])
  recommendedLevel        Level?   @relation("StudentRecommendedLevel", fields: [recommendedLevelId], references: [id])
  recommendedStage        LevelStage? @relation("StudentRecommendedStage", fields: [recommendedStageId], references: [id])
  learningProfile         StudentLearningProfile?
  levelRecommendations    StudentLevelRecommendation[]

  @@index([officialLevelId, officialStageId])
  @@index([recommendedLevelId, recommendedStageId])
}

model Submission {
  id            String     @id @default(uuid()) @map("_id")
  assignmentId  String     
  studentId     String     
  textAnswer    String?
  selectedOption Int?
  attachedFiles String?
  grade         Float?
  feedback      String?
  grammarErrors String?
  submittedAt   DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  Assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  User          User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String             @id @default(uuid()) @map("_id")
  studentId         String             
  packageId         String             
  subscriptionType  SubscriptionType?
  capacity          Int?
  groupId           String?
  status            SubscriptionStatus @default(PENDING)
  paid              Boolean            @default(false)
  paymentMethod     PaymentMethod?
  eWalletProvider   EWalletProvider?
  paymentReference  String?
  receiptUrl        String?
  assignedTeacherId String?            
  approvedAt        DateTime?
  rejectedAt        DateTime?
  adminNotes        String?
  startDate         DateTime?
  endDate           DateTime?
  lessonsAvailable  Int                @default(0)
  lessonsTaken      Int                @default(0)
  preferredDays     String?
  lessonsPerWeek    Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  AssignedTeacher   TeacherProfile?    @relation("AssignedSubscriptions", fields: [assignedTeacherId], references: [id])
  Package           Package            @relation(fields: [packageId], references: [id])
  User              User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Enrollment        Enrollment[]
  group             LearningGroup?     @relation("SubscriptionGroup", fields: [groupId], references: [id])

  @@index([studentId, status])
  @@index([assignedTeacherId, status])
  @@index([groupId, status])
}

model TeacherProfile {
  id                    String         @id @default(uuid()) @map("_id")
  userId                String         @unique 
  bio                   String?
  subjects              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt
  FreeWriting           FreeWriting[]  @relation("FreeWritingGrader")
  Session               Session[]
  AssignedSubscriptions Subscription[] @relation("AssignedSubscriptions")
  User                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  WritingTest           WritingTest[]
  learningGroups        LearningGroup[]
  groupSchedules        GroupSchedule[]
  enrollments           Enrollment[] @relation("EnrollmentTeacher")
  moderatedSpeakingRooms SpeakingRoom[] @relation("SpeakingRoomModerator")
}

model Certificate {
  id             String   @id @default(uuid()) @map("_id")
  studentId      String
  adminId        String?
  level          String
  issueDate      DateTime @default(now())
  certificateUrl String?
  isManual       Boolean  @default(false)
  issuerName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  User           User     @relation("UserCertificates", fields: [studentId], references: [id], onDelete: Cascade)
}

model User {
  id                         String                    @id @default(uuid()) @map("_id")
  email                      String                    @unique
  name                       String
  phone                      String?
  passwordHash               String
  role                       String                    @default("STUDENT")
  profilePhoto               String?
  isActive                   Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @default(now()) @updatedAt
  Cart                       Cart?
  Chat_Chat_fromUserIdToUser Chat[]                    @relation("Chat_fromUserIdToUser")
  Chat_Chat_toUserIdToUser   Chat[]                    @relation("Chat_toUserIdToUser")
  FreeWriting                FreeWriting[]             @relation("FreeWritingStudent")
  SessionStudent             SessionStudent[]
  StudentProfile             StudentProfile?
  Submission                 Submission[]
  Subscription               Subscription[]
  TeacherProfile             TeacherProfile?
  Word                       Word[]
  WritingTestSubmission      WritingTestSubmission[]
  LessonProgress             LessonProgress[]
  ExerciseAttempt            ExerciseAttempt[]
  ConversationProgress       ConversationProgress[]
  VoiceRecording             VoiceRecording[]
  TextConversationAttempt    TextConversationAttempt[]
  Gamification               UserGamification?
  certificates               Certificate[]             @relation("UserCertificates")
  PlacementTestAttempt       PlacementTestAttempt[]
  TestAttempt                TestAttempt[]
  normalizedPhone            String?
  status                     String                    @default("PENDING")
  phoneVerifiedAt            DateTime?
  lastSeenAt                 DateTime?
  staffPermissions           StaffPermission[]
  learningProfile            StudentLearningProfile?
  learningProgress           LearningProgress[]
  enrollments                Enrollment[]              @relation("EnrollmentStudent")
  groupMemberships           GroupMember[]
  sessionParticipants        SessionParticipant[]
  attendances                Attendance[]
  studentFeedback            SessionFeedback[]         @relation("FeedbackStudent")
  teacherFeedback            SessionFeedback[]         @relation("FeedbackTeacher")
  createdHomework            Homework[]                @relation("HomeworkCreator")
  assignedHomework           Homework[]                @relation("HomeworkStudent")
  homeworkSubmissions        HomeworkSubmission[]
  homeworkReviews            HomeworkReview[]          @relation("HomeworkReviewer")
  speakingRoomMemberships    SpeakingRoomMember[]
  speakingRoomMessages       SpeakingRoomMessage[]
  speakingRoomReports        SpeakingRoomReport[]      @relation("SpeakingRoomReportReporter")
  speakingRoomTargetReports   SpeakingRoomReport[]      @relation("SpeakingRoomReportTarget")
  resolvedSpeakingRoomReports SpeakingRoomReport[]     @relation("SpeakingRoomReportResolver")
  speakingRoomContent         SpeakingRoomContent[]     @relation("SpeakingRoomContentCreator")
  notifications              Notification[]
  whatsappAccounts           WhatsAppAccount[]          @relation("WhatsAppAccountOwner")
  whatsappContacts           WhatsAppContact[]          @relation("WhatsAppContactUser")
  whatsappConversations      WhatsAppConversation[]     @relation("WhatsAppConversationStudent")
  assignedWhatsAppConversations WhatsAppConversation[]  @relation("WhatsAppConversationStaff")
  aiRecommendations          AIRecommendation[]
  aiInteractions             AIInteraction[]
  learningSignals            LearningSignal[]
  dailyLearningSessions      DailyLearningSession[]
  teacherIntelligenceSuggestionsAsTeacher TeacherIntelligenceSuggestion[] @relation("IntelligenceSuggestionTeacher")
  teacherIntelligenceSuggestionsAsStudent TeacherIntelligenceSuggestion[] @relation("IntelligenceSuggestionStudent")
  teacherIntelligenceSuggestionsApproved TeacherIntelligenceSuggestion[] @relation("IntelligenceSuggestionApprover")
  otpChallenges              AuthOtpChallenge[]
  authRateLimits             AuthRateLimit[]          @relation("AuthRateLimitUser")
  levelRecommendations       StudentLevelRecommendation[] @relation("LevelRecommendationTeacher")
  receivedLevelRecommendations StudentLevelRecommendation[] @relation("LevelRecommendationStudent")

  @@index([normalizedPhone])
  @@index([role, status])
}

model AuthOtpChallenge {
  id                String   @id @default(uuid()) @map("_id")
  normalizedPhone   String?
  email             String?
  name              String?
  intent            String   @default("LOGIN")
  channel           String
  codeHash          String
  expiresAt         DateTime
  attempts          Int      @default(0)
  maxAttempts       Int      @default(5)
  resendCount       Int      @default(0)
  requestedAt       DateTime @default(now())
  lastSentAt        DateTime @default(now())
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  requestIpHash     String?
  userAgentHash     String?
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              User?    @relation(fields: [userId], references: [id])

  @@index([normalizedPhone, intent, createdAt])
  @@index([email, intent, createdAt])
  @@index([userId, intent, createdAt])
}

model AuthRateLimit {
  id               String   @id @default(uuid()) @map("_id")
  key              String
  kind             String
  windowStartedAt  DateTime
  count            Int      @default(0)
  blockedUntil     DateTime?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User?    @relation("AuthRateLimitUser", fields: [userId], references: [id])

  @@unique([key, kind])
  @@index([blockedUntil])
  @@index([userId, kind])
}

model Word {
  id               String   @id @default(uuid()) @map("_id")
  studentId        String   
  englishWord      String
  arabicMeaning    String
  exampleSentence  String?
  pronunciationUrl String?
  imageUrl         String?
  known            Boolean  @default(false)
  reviewCount      Int      @default(0)
  correctCount     Int      @default(0)
  incorrectCount   Int      @default(0)
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?
  easeFactor       Float    @default(2.5)
  interval         Int      @default(1)
  category         String?
  level            String   @default("BEGINNER")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  User             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model DailyWord {
  id              String   @id @default(uuid()) @map("_id")
  englishWord     String
  arabicMeaning   String
  exampleSentence String?
  pronunciationUrl String?
  imageUrl        String?
  category        String?
  level           String   @default("BEGINNER")
  dateShown       DateTime
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model Cart {
  id        String     @id @default(uuid()) @map("_id")
  studentId String     @unique 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  User      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @map("_id")
  cartId    String   
  packageId String   
  createdAt DateTime @default(now())
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([cartId, packageId])
}

model WritingTest {
  id                    String                  @id @default(uuid()) @map("_id")
  teacherId             String                  
  title                 String
  titleAr               String?
  instructions          String?
  instructionsAr        String?
  dueDate               DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  TeacherProfile        TeacherProfile          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  WritingTestSubmission WritingTestSubmission[]
}

model WritingTestSubmission {
  id            String      @id @default(uuid()) @map("_id")
  testId        String      
  studentId     String      
  content       String
  manuscriptUrl String?
  grade         Float?
  feedback      String?
  grammarErrors String?
  submittedAt   DateTime    @default(now())
  gradedAt      DateTime?
  updatedAt     DateTime    @default(now()) @updatedAt
  User          User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  WritingTest   WritingTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String    @id @default(uuid()) @map("_id")
  code        String    @unique
  discount    String
  expiryDate  DateTime?
  isActive            Boolean   @default(true)
  applicablePackageId String    @default("ALL")
  useCount            Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model FreeWriting {
  id             String          @id @default(uuid()) @map("_id")
  studentId      String          
  title          String
  content        String
  grade          Float?
  feedback       String?
  grammarErrors  String?
  submittedAt    DateTime        @default(now())
  gradedAt       DateTime?
  teacherId      String?         
  updatedAt      DateTime        @default(now()) @updatedAt
  User           User            @relation("FreeWritingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  TeacherProfile TeacherProfile? @relation("FreeWritingGrader", fields: [teacherId], references: [id])
}

model SiteSettings {
  id              String   @id @default(uuid()) @map("_id")
  whatsappNumber  String?
  supportNumber   String?
  supportEmail    String?
  facebookUrl     String?
  instagramUrl    String?
  heroTitle       String?
  heroTitleAr     String?
  heroSubtitle    String?
  heroSubtitleAr  String?
  learningPath    String?  // JSON string for learning path steps
  updatedAt       DateTime @default(now()) @updatedAt
}

model Test {
  id            String         @id @default(uuid()) @map("_id")
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  level         String         @default("BEGINNER")
  category      String?
  duration      Int?           // Duration in minutes
  passingScore  Int            @default(50)
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  questions     TestQuestion[]
  attempts      TestAttempt[]
}

model TestQuestion {
  id            String   @id @default(uuid()) @map("_id")
  testId        String?
  type          String   @default("MULTIPLE_CHOICE")
  testType      String   @default("PLACEMENT") // PLACEMENT, A1_FINAL, etc.
  question      String
  questionAr    String?
  options       String?  // JSON array
  correctAnswer String
  explanation   String?
  level         String   @default("A1")
  category      String   @default("Grammar")
  points        Int      @default(1)
  order         Int      @default(0)
  test          Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id          String   @id @default(uuid()) @map("_id")
  testId      String
  studentId   String
  score       Int      @default(0)
  totalPoints Int      @default(0)
  status      String   @default("COMPLETED") // COMPLETED, IN_PROGRESS
  startedAt   DateTime @default(now())
  completedAt DateTime?
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  E_WALLET
}

enum EWalletProvider {
  INSTAPAY
  ETISALAT_CASH
}

// نظام الدروس
model Lesson {
  id             String           @id @default(uuid()) @map("_id")
  title          String
  titleAr        String
  description    String?
  descriptionAr  String?
  order          Int              @default(0)
  level          String           @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  category       String?          // Grammar, Vocabulary, Conversation, etc.
  categoryAr     String?
  videoUrl       String?          // رابط الفيديو
  videoDuration  Int?             // مدة الفيديو بالثواني
  articleContent String?          // محتوى المقال بتنسيق HTML/Markdown
  articleContentAr String?        // محتوى المقال بالعربي
  thumbnailUrl   String?          // صورة مصغرة للدرس
  isPublished    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  exercises      Exercise[]
  LessonProgress LessonProgress[]
}

model Exercise {
  id              String           @id @default(uuid()) @map("_id")
  lessonId        String           
  type            ExerciseType
  order           Int              @default(0)
  question        String           // السؤال
  questionAr      String?          // السؤال بالعربي
  options         String?          // الخيارات (JSON array للاختيار من متعدد)
  correctAnswer   String           // الإجابة الصحيحة
  explanation     String?          // شرح الإجابة
  explanationAr   String?          // شرح الإجابة بالعربي
  sentence        String?          // الجملة للقراءة
  sentenceAr      String?          // ترجمة الجملة
  audioUrl        String?          // رابط الصوت للنطق
  imageUrl        String?          // صورة توضيحية
  dragItems       String?          // عناصر السحب والإفلات (JSON)
  dropZones       String?          // مناطق الإفلات (JSON)
  blanks          String?          // الفراغات لملء الفراغ (JSON)
  points          Int              @default(10)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  Lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ExerciseAttempt ExerciseAttempt[]
}

model LessonProgress {
  id             String   @id @default(uuid()) @map("_id")
  studentId      String   
  lessonId       String   
  completed      Boolean  @default(false)
  videoWatched   Boolean  @default(false)
  articleRead    Boolean  @default(false)
  exercisesScore Float?   // نسبة النجاح في التمارين
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  User           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model ExerciseAttempt {
  id          String   @id @default(uuid()) @map("_id")
  studentId   String   
  exerciseId  String   
  answer      String   // إجابة الطالب
  isCorrect   Boolean
  points      Int      @default(0)
  attemptedAt DateTime @default(now())
  User        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum ExerciseType {
  MULTIPLE_CHOICE    // اختيار من متعدد
  FILL_BLANK         // ملء الفراغ
  DRAG_DROP          // سحب وإفلات
  SENTENCE_READING   // قراءة جمل مع ترجمة
  TRUE_FALSE         // صح أو خطأ
}

// نظام الاستماع - Listening System
model ListeningContent {
  id                String              @id @default(uuid()) @map("_id")
  title             String              // عنوان المحتوى
  titleAr           String              // العنوان بالعربي
  description       String?             // وصف المحتوى
  descriptionAr     String?             // الوصف بالعربي
  mediaType         ListeningMediaType  // نوع الوسائط (AUDIO/VIDEO)
  mediaUrl          String              // رابط الملف (MP3/MP4)
  thumbnailUrl      String?             // صورة مصغرة
  duration          Int?                // مدة المحتوى بالثواني
  level             String              @default("BEGINNER") // مستوى الصعوبة
  category          String?             // التصنيف (محادثة، أخبار، قصص، الخ)
  categoryAr        String?             // التصنيف بالعربي
  transcript        String?             // نص المحتوى للمتابعة
  transcriptAr      String?             // النص بالعربي
  order             Int                 @default(0)
  isPublished       Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  exercises         ListeningExercise[]
  progress          ListeningProgress[]
}

model ListeningExercise {
  id                String                   @id @default(uuid()) @map("_id")
  contentId         String                   
  type              ListeningExerciseType
  order             Int                      @default(0)
  question          String                   // السؤال
  questionAr        String?                  // السؤال بالعربي
  options           String?                  // الخيارات (JSON array)
  correctAnswer     String                   // الإجابة الصحيحة
  explanation       String?                  // شرح الإجابة
  explanationAr     String?                  // شرح الإجابة بالعربي
  points            Int                      @default(10)
  timestamp         Int?                     // وقت ظهور السؤال بالثواني (اختياري)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  ListeningContent  ListeningContent         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  attempts          ListeningExerciseAttempt[]
}

model ListeningProgress {
  id               String           @id @default(uuid()) @map("_id")
  contentId        String           
  visitorId        String?          // معرف الزائر (للمستخدمين غير المسجلين)
  completed        Boolean          @default(false)
  listenedDuration Int              @default(0) // المدة التي استمع إليها بالثواني
  exercisesScore   Float?           // نسبة النجاح في التمارين
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  ListeningContent ListeningContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, visitorId])
}

model ListeningExerciseAttempt {
  id          String            @id @default(uuid()) @map("_id")
  exerciseId  String            
  visitorId   String?           // معرف الزائر
  answer      String            // إجابة المستخدم
  isCorrect   Boolean
  points      Int               @default(0)
  attemptedAt DateTime          @default(now())
  Exercise    ListeningExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum ListeningMediaType {
  AUDIO  // MP3
  VIDEO  // MP4
}

enum ListeningExerciseType {
  MULTIPLE_CHOICE    // اختيار من متعدد
  TRUE_FALSE         // صح أو خطأ
  FILL_BLANK         // ملء الفراغ
  WORD_ORDER         // ترتيب الكلمات
}

// نظام المحادثة التدريبية - Conversation Practice System
model ConversationScenario {
  id              String                    @id @default(uuid()) @map("_id")
  title           String                    // عنوان السيناريو
  titleAr         String                    // العنوان بالعربي
  description     String?                   // وصف السيناريو
  descriptionAr   String?                   // الوصف بالعربي
  category        String                    // التصنيف (مطعم، مطار، تسوق، الخ)
  categoryAr      String                    // التصنيف بالعربي
  level           String                    @default("BEGINNER") // مستوى الصعوبة
  imageUrl        String?                   // صورة توضيحية للموقف
  dialogueSteps   String                    // خطوات الحوار (JSON array)
  isPublished     Boolean                   @default(true)
  order           Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @default(now()) @updatedAt
  progress        ConversationProgress[]
}

model ConversationProgress {
  id              String               @id @default(uuid()) @map("_id")
  studentId       String               
  scenarioId      String               
  completed       Boolean              @default(false)
  currentStep     Int                  @default(0)
  score           Int                  @default(0)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  User            User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Scenario        ConversationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([studentId, scenarioId])
}

// نظام تسجيل الصوت - Voice Recording System
model VoiceRecording {
  id              String   @id @default(uuid()) @map("_id")
  studentId       String   
  title           String                    // عنوان التسجيل
  audioData       String                    // Base64 encoded audio data
  duration        Int?                      // مدة التسجيل بالثواني
  promptText      String?                   // النص المطلوب قراءته
  promptTextAr    String?                   // النص بالعربي
  category        String?                   // التصنيف
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  User            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// نظام اختبار تحديد المستوى - Placement Test System
model PlacementQuestion {
  id            String   @id @default(uuid()) @map("_id")
  question      String
  questionAr    String?
  questionType  String   @default("MCQ") // MCQ, WRITTEN, VIDEO_RECORDING, IMAGE
  options       String?  // JSON string array - for MCQ only
  correctAnswer String?  // for MCQ only
  mediaUrl      String?  // URL for image/video questions
  explanation   String?  // explanation for the correct answer
  points        Int      @default(1)
  order         Int      @default(0)
  level         String   @default("A1")
  testType      String   @default("PLACEMENT")
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model TestSettings {
  id              String   @id @default(uuid()) @map("_id")
  testType        String   @unique
  questionsCount  Int      @default(10)
  timeLimitMins   Int      @default(30)
  passScore       Int      @default(60)
  shuffleQuestions Boolean @default(true)
  updatedAt       DateTime @default(now()) @updatedAt
}

model PageContent {
  id        String   @id @default(uuid()) @map("_id")
  page      String
  section   String
  field     String
  value     String
  type      String   @default("text") // text, image, color, url, richtext
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([page, section, field])
}

model PlacementTestAttempt {
  id          String   @id @default(uuid()) @map("_id")
  studentId   String
  testType    String   @default("PLACEMENT")
  score       Int      @default(0)
  percentage  Float    @default(0)
  levelResult String?  // المستوى الذي تم تحديده
  details     String?  // تفاصيل الإجابات (JSON)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  User        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// نظام المحادثة النصية - Text Conversation System
model TextConversation {
  id              String                     @id @default(uuid()) @map("_id")
  title           String                     // عنوان المحادثة
  titleAr         String                     // العنوان بالعربي
  description     String?                    // وصف المحادثة
  descriptionAr   String?                    // الوصف بالعربي
  level           String                     @default("BEGINNER")
  questions       String                     // الأسئلة (JSON array)
  isPublished     Boolean                    @default(true)
  order           Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @default(now()) @updatedAt
  attempts        TextConversationAttempt[]
}

model TextConversationAttempt {
  id              String           @id @default(uuid()) @map("_id")
  studentId       String           
  conversationId  String           
  answers         String           // إجابات الطالب (JSON array)
  score           Int              @default(0)
  totalQuestions  Int              @default(0)
  completedAt     DateTime         @default(now())
  User            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Conversation    TextConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// =============================================
// نظام Gamification - نظام الألعاب والمكافآت
// =============================================

// إحصائيات اللاعب - Player Stats
model UserGamification {
  id              String          @id @default(uuid()) @map("_id")
  userId          String          @unique 
  totalXP         Int             @default(0)         // إجمالي نقاط الخبرة
  currentLevel    Int             @default(1)         // المستوى الحالي
  currentLevelXP  Int             @default(0)         // XP في المستوى الحالي
  xpToNextLevel   Int             @default(100)       // XP المطلوب للمستوى التالي
  totalPoints     Int             @default(0)         // إجمالي النقاط
  currentStreak   Int             @default(0)         // سلسلة الأيام الحالية
  longestStreak   Int             @default(0)         // أطول سلسلة أيام
  lastActiveDate  DateTime?                           // آخر يوم نشاط
  wordsLearned    Int             @default(0)         // عدد الكلمات المتعلمة
  lessonsCompleted Int            @default(0)         // عدد الدروس المكتملة
  exercisesCompleted Int          @default(0)         // عدد التمارين المكتملة
  writingsSubmitted Int           @default(0)         // عدد الكتابات المقدمة
  perfectScores   Int             @default(0)         // عدد الدرجات الكاملة
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBadges      UserBadge[]
  dailyActivities DailyActivity[]
}

// تعريف الشارات - Badge Definitions
model Badge {
  id              String      @id @default(uuid()) @map("_id")
  name            String      // اسم الشارة بالإنجليزية
  nameAr          String      // اسم الشارة بالعربية
  description     String      // وصف الشارة بالإنجليزية
  descriptionAr   String      // وصف الشارة بالعربية
  icon            String      // أيقونة الشارة (emoji أو رابط صورة)
  category        BadgeCategory // تصنيف الشارة
  requirement     String      // متطلبات الحصول على الشارة (JSON)
  xpReward        Int         @default(0)  // مكافأة XP عند الحصول على الشارة
  pointsReward    Int         @default(0)  // مكافأة النقاط
  rarity          BadgeRarity @default(COMMON) // ندرة الشارة
  isActive        Boolean     @default(true)
  order           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  userBadges      UserBadge[]
}

// شارات المستخدم - User Badges
model UserBadge {
  id              String           @id @default(uuid()) @map("_id")
  gamificationId  String           
  badgeId         String           
  earnedAt        DateTime         @default(now())
  UserGamification UserGamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)
  Badge           Badge            @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([gamificationId, badgeId])
}

// النشاط اليومي - Daily Activity (للـ Streak)
model DailyActivity {
  id              String           @id @default(uuid()) @map("_id")
  gamificationId  String           
  date            DateTime         // تاريخ اليوم
  xpEarned        Int              @default(0)  // XP المكتسب في هذا اليوم
  pointsEarned    Int              @default(0)  // النقاط المكتسبة
  activitiesCount Int              @default(0)  // عدد الأنشطة المنجزة
  wordsLearned    Int              @default(0)  // الكلمات المتعلمة
  lessonsCompleted Int             @default(0)  // الدروس المكتملة
  exercisesDone   Int              @default(0)  // التمارين المنجزة
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  UserGamification UserGamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)

  @@unique([gamificationId, date])
}

// تصنيفات الشارات
enum BadgeCategory {
  STREAK       // شارات السلسلة اليومية
  LEARNING     // شارات التعلم
  ACHIEVEMENT  // شارات الإنجاز
  SOCIAL       // شارات اجتماعية
  SPECIAL      // شارات خاصة
}

// ندرة الشارات
enum BadgeRarity {
  COMMON       // شائعة
  UNCOMMON     // غير شائعة
  RARE         // نادرة
  EPIC         // ملحمية
  LEGENDARY    // أسطورية
}

model LiveSession {
  id        String   @id @default(uuid()) @map("_id")
  sessionId String
  teacherId String
  status    String   @default("LIVE")
  startedAt DateTime @default(now())
  endedAt   DateTime?
}

model LiveParticipant {
  id         String    @id @default(uuid()) @map("_id")
  liveId     String
  userId     String
  role       String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  raisedHand Boolean   @default(false)

  @@unique([liveId, userId])
}


model TrialBooking {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  phone     String
  email     String?
  fromLevel String
  toLevel   String
  plan      String
  price     Float?
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Phase 2 target-domain models follow.

model StaffPermission {
  id         String   @id @default(uuid()) @map("_id")
  userId     String
  permission String
  scope      String?
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, permission])
}

model Level {
  id                          String                    @id @default(uuid()) @map("_id")
  code                        String                    @unique
  name                        String
  nameAr                      String?
  description                 String?
  descriptionAr               String?
  order                       Int                       @default(0)
  isActive                    Boolean                   @default(true)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @default(now()) @updatedAt
  stages                      LevelStage[]              @relation("LevelStages")
  resources                   Resource[]                @relation("ResourceLevel")
  officialStudents            StudentProfile[]          @relation("StudentOfficialLevel")
  recommendedStudents         StudentProfile[]          @relation("StudentRecommendedLevel")
  officialLearningProfiles    StudentLearningProfile[]  @relation("LearningProfileOfficialLevel")
  recommendedLearningProfiles StudentLearningProfile[]  @relation("LearningProfileRecommendedLevel")
  groups                      LearningGroup[]           @relation("LearningGroupLevel")
  packages                    Package[]                 @relation("PackageLevel")
  sessions                    Session[]                 @relation("SessionLevel")
  learningProgress            LearningProgress[]        @relation("LearningProgressLevel")
  speakingRooms               SpeakingRoom[]            @relation("SpeakingRoomLevel")
  aiRecommendations            AIRecommendation[]        @relation("AIRecommendationLevel")
  levelRecommendations         StudentLevelRecommendation[] @relation("RecommendationLevel")

  @@index([isActive, order])
}

model LevelStage {
  id                          String                    @id @default(uuid()) @map("_id")
  levelId                     String
  code                        String
  name                        String
  nameAr                      String?
  order                       Int                       @default(0)
  isActive                    Boolean                   @default(true)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @default(now()) @updatedAt
  level                       Level                     @relation("LevelStages", fields: [levelId], references: [id], onDelete: Cascade)
  resources                   Resource[]                @relation("ResourceStage")
  officialStudents            StudentProfile[]          @relation("StudentOfficialStage")
  recommendedStudents         StudentProfile[]          @relation("StudentRecommendedStage")
  officialLearningProfiles    StudentLearningProfile[]  @relation("LearningProfileOfficialStage")
  recommendedLearningProfiles StudentLearningProfile[]  @relation("LearningProfileRecommendedStage")
  groups                      LearningGroup[]           @relation("LearningGroupStage")
  packages                    Package[]                 @relation("PackageStage")
  sessions                    Session[]                 @relation("SessionStage")
  learningProgress            LearningProgress[]        @relation("LearningProgressStage")
  speakingRooms               SpeakingRoom[]            @relation("SpeakingRoomStage")
  aiRecommendations            AIRecommendation[]        @relation("AIRecommendationStage")
  levelRecommendations         StudentLevelRecommendation[] @relation("RecommendationStage")

  @@unique([levelId, code])
  @@index([levelId, isActive, order])
}

model Skill {
  id               String             @id @default(uuid()) @map("_id")
  code             String             @unique
  name             String
  nameAr           String?
  description      String?
  descriptionAr    String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  resources        Resource[]         @relation("ResourceSkill")
  learningProgress LearningProgress[] @relation("LearningProgressSkill")
  learningSignals  LearningSignal[]
  aiRecommendations AIRecommendation[]
}

model Resource {
  id            String             @id @default(uuid()) @map("_id")
  resourceType  String
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  contentRef    String?
  legacyModel   String?
  legacyId      String?
  levelId       String?
  stageId       String?
  skillId       String?
  order         Int                @default(0)
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  level         Level?             @relation("ResourceLevel", fields: [levelId], references: [id])
  stage         LevelStage?        @relation("ResourceStage", fields: [stageId], references: [id])
  skill         Skill?             @relation("ResourceSkill", fields: [skillId], references: [id])
  progress      LearningProgress[] @relation("ResourceProgress")
  aiRecommendations AIRecommendation[]
  learningSignals LearningSignal[]

  @@index([resourceType, isPublished])
  @@index([levelId, stageId, order])
  @@index([legacyModel, legacyId])
}

model LearningProgress {
  id           String      @id @default(uuid()) @map("_id")
  userId       String
  resourceId   String?
  skillId      String?
  levelId      String?
  stageId      String?
  status       String      @default("NOT_STARTED")
  score        Float?
  metadataJson String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     Resource?   @relation("ResourceProgress", fields: [resourceId], references: [id])
  skill        Skill?      @relation("LearningProgressSkill", fields: [skillId], references: [id])
  level        Level?      @relation("LearningProgressLevel", fields: [levelId], references: [id])
  stage        LevelStage? @relation("LearningProgressStage", fields: [stageId], references: [id])

  @@index([userId, status])
  @@index([userId, resourceId])
  @@index([levelId, stageId])
}

model StudentLearningProfile {
  id                  String         @id @default(uuid()) @map("_id")
  userId              String         @unique
  studentProfileId    String         @unique
  officialLevelId     String?
  officialStageId     String?
  recommendedLevelId  String?
  recommendedStageId  String?
  goalsJson           String?
  strengthsJson       String?
  weaknessesJson      String?
  recentFeedbackJson  String?
  commonMistakesJson  String?
  vocabularyJson      String?
  pronunciationJson   String?
  homeworkHistoryJson String?
  learningHistoryJson String?
  recommendationsJson String?
  targetSkillsJson    String?
  speakingNeedsJson   String?
  engagementJson      String?
  lastReviewedAt      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentProfile      StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  officialLevel       Level?         @relation("LearningProfileOfficialLevel", fields: [officialLevelId], references: [id])
  officialStage       LevelStage?    @relation("LearningProfileOfficialStage", fields: [officialStageId], references: [id])
  recommendedLevel    Level?         @relation("LearningProfileRecommendedLevel", fields: [recommendedLevelId], references: [id])
  recommendedStage    LevelStage?    @relation("LearningProfileRecommendedStage", fields: [recommendedStageId], references: [id])

  @@index([officialLevelId, officialStageId])
  @@index([recommendedLevelId, recommendedStageId])
}

model StudentLevelRecommendation {
  id                String      @id @default(uuid()) @map("_id")
  teacherId         String
  studentId         String
  studentProfileId  String
  recommendedLevelId String
  recommendedStageId String?
  reason            String?
  createdAt         DateTime    @default(now())
  teacher           User        @relation("LevelRecommendationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student           User        @relation("LevelRecommendationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  recommendedLevel  Level       @relation("RecommendationLevel", fields: [recommendedLevelId], references: [id])
  recommendedStage  LevelStage? @relation("RecommendationStage", fields: [recommendedStageId], references: [id])

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
}

model Enrollment {
  id               String         @id @default(uuid()) @map("_id")
  studentId        String
  subscriptionId   String?
  packageId        String?
  groupId          String?
  teacherProfileId String?
  subscriptionType SubscriptionType
  status           String         @default("PENDING")
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  student          User           @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])
  package          Package?       @relation(fields: [packageId], references: [id])
  group            LearningGroup? @relation("EnrollmentGroup", fields: [groupId], references: [id])
  teacher          TeacherProfile? @relation("EnrollmentTeacher", fields: [teacherProfileId], references: [id])

  @@index([studentId, status])
  @@index([groupId, status])
  @@index([subscriptionType, status])
}

model LearningGroup {
  id               String          @id @default(uuid()) @map("_id")
  name             String
  nameAr           String?
  levelId          String?
  stageId          String?
  subscriptionType SubscriptionType
  teacherProfileId String?
  capacity         Int?
  timezone         String?
  status           String          @default("DRAFT")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  level            Level?          @relation("LearningGroupLevel", fields: [levelId], references: [id])
  stage            LevelStage?     @relation("LearningGroupStage", fields: [stageId], references: [id])
  teacher          TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  members          GroupMember[]   @relation("GroupMembers")
  schedules        GroupSchedule[]
  enrollments      Enrollment[]    @relation("EnrollmentGroup")
  subscriptions    Subscription[]  @relation("SubscriptionGroup")
  sessions         Session[]       @relation("GroupSessions")
  homework         Homework[]      @relation("GroupHomework")

  @@index([levelId, stageId, status])
  @@index([teacherProfileId, status])
}

model GroupMember {
  id           String        @id @default(uuid()) @map("_id")
  groupId      String
  userId       String
  enrollmentId String?
  role         String        @default("STUDENT")
  status       String        @default("ACTIVE")
  joinedAt     DateTime      @default(now())
  leftAt       DateTime?
  group        LearningGroup @relation("GroupMembers", fields: [groupId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status])
}

model GroupSchedule {
  id               String          @id @default(uuid()) @map("_id")
  groupId          String
  teacherProfileId String?
  dayOfWeek        Int
  startMinute      Int
  durationMinutes  Int
  timezone         String
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  group            LearningGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  sessions         Session[]       @relation("ScheduledSessions")

  @@index([groupId, status])
  @@index([teacherProfileId, dayOfWeek, startMinute])
}

model SessionParticipant {
  id        String   @id @default(uuid()) @map("_id")
  sessionId String
  userId    String
  role      String   @default("STUDENT")
  status    String   @default("SCHEDULED")
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, createdAt])
}

model Attendance {
  id              String   @id @default(uuid()) @map("_id")
  sessionId       String
  userId          String
  status          String   @default("PENDING")
  joinedAt        DateTime?
  leftAt          DateTime?
  durationSeconds Int?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId, status])
}

model QMeetMeeting {
  id                String   @id @default(uuid()) @map("_id")
  sessionId         String   @unique
  providerMeetingId String?
  provider          String   @default("QMEET")
  joinUrl           String?
  hostUrl           String?
  status            String   @default("CREATED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([providerMeetingId])
  @@index([status, createdAt])
}

model SessionFeedback {
  id             String                  @id @default(uuid()) @map("_id")
  sessionId      String
  studentId      String
  teacherId      String
  summary        String?
  teacherNotes   String?
  status         String                  @default("DRAFT")
  publishedAt    DateTime?
  publishedById  String?
  publicationVersion Int                     @default(0)
  editAfterPublishAllowed Boolean             @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  session        Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        User                    @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User                    @relation("FeedbackTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  expressions    FeedbackExpression[]
  mistakes       FeedbackMistake[]
  pronunciation  FeedbackPronunciation[]
  ebi            FeedbackEBI[]
  revisions      FeedbackRevision[]

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([teacherId, status])
}

model FeedbackRevision {
  id           String          @id @default(uuid()) @map("_id")
  feedbackId   String
  version      Int
  snapshotJson String
  changedById  String
  reason       String?
  createdAt    DateTime        @default(now())
  feedback     SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, version])
  @@index([changedById, createdAt])
}

model FeedbackExpression {
  id         String          @id @default(uuid()) @map("_id")
  feedbackId String
  expression String
  meaning    String?
  example    String?
  category   String?
  createdAt  DateTime        @default(now())
  feedback   SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model FeedbackMistake {
  id          String          @id @default(uuid()) @map("_id")
  feedbackId  String
  original    String
  correction  String
  explanation String?
  templateId  String?
  createdAt   DateTime        @default(now())
  feedback    SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model FeedbackPronunciation {
  id         String          @id @default(uuid()) @map("_id")
  feedbackId String
  target     String
  actual     String?
  guidance   String?
  phonetic   String?
  teacherNote String?
  audioRef   String?
  createdAt  DateTime        @default(now())
  feedback   SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model FeedbackEBI {
  id               String          @id @default(uuid()) @map("_id")
  feedbackId       String
  betterExpression String
  explanation      String?
  priority         String          @default("NORMAL")
  libraryItemId    String?
  createdAt        DateTime        @default(now())
  feedback         SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model EBILibraryItem {
  id          String   @id @default(uuid()) @map("_id")
  category    String
  title       String
  description String?
  levelId     String?
  stageId     String?
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status, category])
  @@index([levelId, stageId])
}

model MistakeTemplate {
  id                  String   @id @default(uuid()) @map("_id")
  category            String
  incorrectExpression String
  correctedExpression String
  explanation         String?
  levelId             String?
  stageId             String?
  status              String   @default("ACTIVE")
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([status, category])
  @@index([levelId, stageId])
}

model Homework {
  id          String               @id @default(uuid()) @map("_id")
  createdById String
  studentId   String?
  groupId     String?
  sessionId   String?
  title       String
  description String?
  status      String               @default("DRAFT")
  dueAt       DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  creator     User                 @relation("HomeworkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  student     User?                @relation("HomeworkStudent", fields: [studentId], references: [id])
  group       LearningGroup?       @relation("GroupHomework", fields: [groupId], references: [id])
  session     Session?             @relation("SessionHomework", fields: [sessionId], references: [id])
  items       HomeworkItem[]
  submissions HomeworkSubmission[]

  @@index([createdById, status])
  @@index([studentId, status, dueAt])
  @@index([groupId, status])
}

model HomeworkItem {
  id          String              @id @default(uuid()) @map("_id")
  homeworkId  String
  itemType    String
  prompt      String?
  contentRef  String?
  isRequired  Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  homework    Homework            @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[] @relation("HomeworkItemSubmissions")

  @@index([homeworkId, order])
}

model HomeworkSubmission {
  id          String        @id @default(uuid()) @map("_id")
  homeworkId  String
  itemId     String?
  studentId  String
  attempt    Int           @default(1)
  contentType String
  contentText String?
  contentRef String?
  status     String        @default("SUBMITTED")
  submittedAt DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  homework   Homework      @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  item       HomeworkItem? @relation("HomeworkItemSubmissions", fields: [itemId], references: [id])
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviews    HomeworkReview[]

  @@unique([homeworkId, itemId, studentId, attempt])
  @@index([homeworkId, studentId, status])
  @@index([studentId, submittedAt])
}

model HomeworkReview {
  id           String             @id @default(uuid()) @map("_id")
  submissionId String
  teacherId    String
  score        Float?
  feedback     String?
  status       String             @default("REVIEWED")
  reviewedAt   DateTime           @default(now())
  corrections  String?
  nextSteps    String?
  completedAt  DateTime?
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher      User               @relation("HomeworkReviewer", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([submissionId])
  @@index([teacherId, reviewedAt])
}

model SpeakingRoom {
  id          String               @id @default(uuid()) @map("_id")
  name        String?
  description String?
  levelId     String?
  stageId     String?
  topic       String
  prompt      String?
  vocabularyJson String?
  status      String               @default("OPEN")
  maxMembers  Int?
  createdById String?
  moderatorTeacherProfileId String?
  activeMemberCount Int       @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  level       Level?               @relation("SpeakingRoomLevel", fields: [levelId], references: [id])
  stage       LevelStage?          @relation("SpeakingRoomStage", fields: [stageId], references: [id])
  moderatorTeacherProfile TeacherProfile? @relation("SpeakingRoomModerator", fields: [moderatorTeacherProfileId], references: [id])
  members     SpeakingRoomMember[]
  messages    SpeakingRoomMessage[]
  reports     SpeakingRoomReport[]
  content     SpeakingRoomContent[]

  @@index([levelId, stageId, status])
}

model SpeakingRoomMember {
  id        String        @id @default(uuid()) @map("_id")
  roomId    String
  userId    String
  role      String        @default("MEMBER")
  status    String        @default("ACTIVE")
  muted     Boolean       @default(false)
  joinedAt  DateTime      @default(now())
  leftAt    DateTime?
  room      SpeakingRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, status])
}

model SpeakingRoomMessage {
  id          String       @id @default(uuid()) @map("_id")
  roomId      String
  senderId    String
  messageType String       @default("TEXT")
  text        String?
  voiceRef    String?
  status      String       @default("VISIBLE")
  createdAt   DateTime     @default(now())
  room        SpeakingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports     SpeakingRoomReport[]

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
}

model SpeakingRoomReport {
  id             String              @id @default(uuid()) @map("_id")
  roomId         String
  reporterId     String
  targetUserId   String?
  messageId      String?
  reason         String
  status         String              @default("OPEN")
  resolutionNote String?
  resolvedById   String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  room           SpeakingRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reporter       User                @relation("SpeakingRoomReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser     User?               @relation("SpeakingRoomReportTarget", fields: [targetUserId], references: [id])
  message        SpeakingRoomMessage? @relation(fields: [messageId], references: [id])
  resolvedBy     User?               @relation("SpeakingRoomReportResolver", fields: [resolvedById], references: [id])

  @@index([roomId, status, createdAt])
  @@index([reporterId, createdAt])
}

model SpeakingRoomContent {
  id          String       @id @default(uuid()) @map("_id")
  roomId      String?
  contentType String
  text        String
  status      String       @default("ACTIVE")
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  room        SpeakingRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("SpeakingRoomContentCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([roomId, contentType, status])
}

model Notification {
  id             String   @id @default(uuid()) @map("_id")
  userId         String
  eventType      String
  channel        String
  title          String?
  body           String?
  payloadJson    String?
  deliveryStatus String   @default("PENDING")
  idempotencyKey String?
  dedupeKey      String   @unique @default(uuid())
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliveryStatus, createdAt])
  @@index([eventType, channel])
  @@index([idempotencyKey])
}

model WhatsAppAccount {
  id              String                @id @default(uuid()) @map("_id")
  userId          String?
  provider        String
  phoneNumber     String
  normalizedPhone String?
  status          String                @default("DISCONNECTED")
  authPersistenceStatus String           @default("PERSISTENCE_UNAVAILABLE")
  reconnectAttempts Int                 @default(0)
  lastError       String?
  workerLockToken String?
  workerLockedAt  DateTime?
  lastMessageSentAt DateTime?
  metadataJson    String?
  lastConnectedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  owner           User?                 @relation("WhatsAppAccountOwner", fields: [userId], references: [id])
  contacts        WhatsAppContact[]
  conversations   WhatsAppConversation[]
  queues          WhatsAppQueue[]

  @@index([normalizedPhone])
  @@index([provider, status])
}

model WhatsAppContact {
  id              String                @id @default(uuid()) @map("_id")
  accountId       String
  userId          String?
  phoneNumber     String
  normalizedPhone String?
  displayName     String?
  status          String                @default("ACTIVE")
  isGroup         Boolean               @default(false)
  lastInteractionAt DateTime?
  metadataJson    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  account         WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user            User?                 @relation("WhatsAppContactUser", fields: [userId], references: [id])
  conversations   WhatsAppConversation[]

  @@unique([accountId, normalizedPhone])
  @@index([userId, status])
}

model WhatsAppConversation {
  id             String               @id @default(uuid()) @map("_id")
  accountId      String
  contactId      String
  studentId      String?
  assignedStaffId String?
  status         String               @default("OPEN")
  unreadCount    Int                  @default(0)
  lastMessageAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  account        WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact        WhatsAppContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  student        User?                @relation("WhatsAppConversationStudent", fields: [studentId], references: [id])
  assignedStaff  User?                @relation("WhatsAppConversationStaff", fields: [assignedStaffId], references: [id])
  messages       WhatsAppMessage[]
  queues         WhatsAppQueue[]

  @@index([accountId, status, lastMessageAt])
  @@index([contactId, status])
  @@index([studentId, status])
}

model WhatsAppMessage {
  id                String               @id @default(uuid()) @map("_id")
  conversationId    String
  direction         String
  mode              String               @default("MANUAL")
  body              String?
  providerMessageId String?
  deliveryStatus    String               @default("PENDING")
  metadataJson      String?
  idempotencyKey    String?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime             @default(now())
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  queueItems        WhatsAppQueue[]

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@index([idempotencyKey])
}

model WhatsAppQueue {
  id             String                @id @default(uuid()) @map("_id")
  accountId      String?
  conversationId String?
  messageId      String?
  notificationId String?
  recipientPhone String?
  status         String                @default("PENDING")
  dedupeKey      String                @unique
  availableAt    DateTime              @default(now())
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(3)
  nextAttemptAt  DateTime              @default(now())
  lastAttemptAt  DateTime?
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  account        WhatsAppAccount?      @relation(fields: [accountId], references: [id])
  conversation   WhatsAppConversation? @relation(fields: [conversationId], references: [id])
  message        WhatsAppMessage?      @relation(fields: [messageId], references: [id])

  @@index([status, availableAt])
  @@index([accountId, status, availableAt])
}

model AIRecommendation {
  id          String      @id @default(uuid()) @map("_id")
  studentId   String
  levelId     String?
  stageId     String?
  type        String
  title       String?
  reason      String?
  priority    Int         @default(50)
  skillId     String?
  resourceId  String?
  dedupeKey   String
  evidenceCycleKey String   @default("LEGACY")
  dedupeCycle Int          @default(1)
  sourceSignalKeysJson String?
  payloadJson String?
  status      String      @default("PENDING")
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       Level?      @relation("AIRecommendationLevel", fields: [levelId], references: [id])
  stage       LevelStage? @relation("AIRecommendationStage", fields: [stageId], references: [id])
  skill       Skill?      @relation(fields: [skillId], references: [id])
  resource    Resource?   @relation(fields: [resourceId], references: [id])
  dailySteps  DailyLearningSessionStep[]

  @@unique([studentId, dedupeKey, dedupeCycle])
  @@index([studentId, dedupeKey, evidenceCycleKey])
  @@index([studentId, status, createdAt])
  @@index([studentId, priority, status])
  @@index([levelId, stageId])
}

model LearningSignal {
  id             String   @id @default(uuid()) @map("_id")
  studentId      String
  type           String
  source         String
  sourceEntityType String?
  sourceEntityId String?
  sourceItemKey  String?
  dedupeKey      String
  skillId        String?
  levelId        String?
  stageId        String?
  topicKey       String?
  strength       Float    @default(1)
  occurredAt     DateTime
  expiresAt      DateTime?
  evidenceJson   String?
  createdAt      DateTime @default(now())
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill          Skill?   @relation(fields: [skillId], references: [id])
  resource       Resource? @relation(fields: [resourceId], references: [id])
  resourceId     String?

  @@unique([studentId, dedupeKey])
  @@index([studentId, type, occurredAt])
  @@index([studentId, skillId, occurredAt])
  @@index([sourceEntityType, sourceEntityId])
}

model DailyLearningSession {
  id                String                    @id @default(uuid()) @map("_id")
  studentId         String
  dailyKey          String
  status            String                    @default("NOT_STARTED")
  planSnapshotJson  String
  totalMinutes      Int
  currentStepIndex  Int                       @default(0)
  progressJson      String?
  startedAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  abandonedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  student           User                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps             DailyLearningSessionStep[]

  @@unique([studentId, dailyKey])
  @@index([studentId, status, dailyKey])
}

model DailyLearningSessionStep {
  id               String               @id @default(uuid()) @map("_id")
  sessionId        String
  stepIndex        Int
  type             String
  status           String               @default("PENDING")
  recommendationId String?
  resourceId       String?
  durationMinutes  Int
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  session          DailyLearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recommendation   AIRecommendation?    @relation(fields: [recommendationId], references: [id])

  @@unique([sessionId, stepIndex])
  @@index([sessionId, status])
}

model TeacherIntelligenceSuggestion {
  id           String   @id @default(uuid()) @map("_id")
  teacherId    String
  studentId    String
  type         String
  draftJson    String
  reason       String
  status       String   @default("DRAFT")
  approvedById String?
  approvedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  teacher      User     @relation("IntelligenceSuggestionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student      User     @relation("IntelligenceSuggestionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy   User?    @relation("IntelligenceSuggestionApprover", fields: [approvedById], references: [id])

  @@index([studentId, status, createdAt])
  @@index([teacherId, status, createdAt])
}

model AIInteraction {
  id         String   @id @default(uuid()) @map("_id")
  userId     String?
  studentId  String?
  feature    String
  inputHash  String?
  inputJson  String?
  outputJson String?
  model      String?
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([studentId, feature, createdAt])
}

enum SubscriptionType {
  GROUP
  DUO
  PRIVATE
  SMALL_GROUP
}
